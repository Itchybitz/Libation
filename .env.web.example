# Copy to .env next to docker-compose.web.yml and fill in. See docs/installation/web-portal.md.

# The DSM (or Linux) user that can read the config folder and write the books folder: `id <username>`.
PUID=1026
PGID=100

# Folder holding AccountsSettings.json, Settings.json, libation-master.key and LibationContext.db.
LIBATION_CONFIG_PATH=/volume1/docker/libation/config

# Where downloaded books go. Point it at the folder your player scans; for Nightstand that is
# SHELVES_PATH (with SINGLE_SHELF set, since Libation makes one folder per title).
LIBATION_BOOKS_PATH=/volume1/media/AudioBooks

# Port on the NAS. The phone opens http://nas:8791 (or the reverse proxy / Tailscale address).
LIBATION_WEB_PORT=8791

# Sign-in password for the portal. 8+ characters. Anyone who knows it can download to your NAS.
LIBATION_WEB_PASSWORD=

# Optional: a long random secret that Nightstand (or a script) sends as a bearer token to use the API.
# Generate one with:  openssl rand -hex 32
LIBATION_WEB_TOKEN=

# Books downloaded at once (1-4).
LIBATION_WEB_CONCURRENCY=1

# Leave empty until DSM's reverse proxy is in front; then the docker bridge gateway, e.g. 172.17.0.1
LIBATION_WEB_TRUST_PROXY=

# Time zone for timestamps in the log.
TZ=UTC
